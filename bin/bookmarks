#!/bin/bash

# Use Rofi to select a bookmark
cat ~/org/gtd/bookmark.org \
| awk -F'[][]' '
  /\[\[http/ {
    url = $3;
    title = $5;
    print title "   →   " url
  }
' | rofi -dmenu -i -p "Open bookmark" -theme ~/.config/rofi/launchers/type-4/style-1.rasi \
| awk -F'   →   ' '{print $2}' \
| xargs -r xdg-open
